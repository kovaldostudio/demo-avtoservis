---
import { site } from "../../lib/site";

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: site.faq.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a.trim() },
  })),
};
---

<section id="faq" class="section faq">
  <div class="shell faq__in">
    <div class="faq__aside">
      <p class="eyebrow">Питання</p>
      <h2>{site.faqTitle}</h2>
      <p class="faq__hint">
        Не знайшли свого? Напишіть у <a href={site.contacts.telegram}>Telegram</a> — відповімо того ж дня.
      </p>
    </div>

    <div class="faq__list">
      {
        site.faq.map((f, i) => (
          <details class="faq__item" open={i === 0}>
            <summary>
              <span>{f.q}</span>
              <svg class="faq__chev" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                <path d="M3 6 L8 11 L13 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </summary>
            <p>{f.a.trim()}</p>
          </details>
        ))
      }
    </div>
  </div>

  <set:html value={`<script type="application/ld+json">${JSON.stringify(faqLd)}</script>`} />
</section>

<style>
  .faq__in {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 56px;
    align-items: start;
  }
  .faq__hint { margin-top: 18px; font-size: 0.92rem; color: var(--fg-soft); }
  /* Підкреслення обовʼязкове: посилання всередині абзацу не можна
     відрізняти лише кольором — це порушення WCAG (правило link-in-text-block). */
  .faq__hint a { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }

  .faq__list { display: flex; flex-direction: column; }
  .faq__item { border-top: 1px solid var(--line); }
  .faq__item:last-child { border-bottom: 1px solid var(--line); }

  .faq__item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 20px 0;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-size: 1.06rem;
    line-height: 1.3;
  }
  .faq__item summary::-webkit-details-marker { display: none; }
  .faq__item summary:hover { color: var(--accent); }

  .faq__chev {
    width: 16px;
    height: 16px;
    flex: none;
    color: var(--accent);
    transition: transform 0.2s ease;
  }
  .faq__item[open] .faq__chev { transform: rotate(180deg); }

  .faq__item p {
    padding-bottom: 22px;
    color: var(--fg-soft);
    font-size: 0.97rem;
    max-width: 62ch;
  }

  @media (max-width: 860px) {
    .faq__in { grid-template-columns: 1fr; gap: 32px; }
  }
</style>
