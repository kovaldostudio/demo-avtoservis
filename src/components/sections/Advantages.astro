---
import { site } from "../../lib/site";
---

<section class="section--tight adv">
  <div class="shell">
    <div class="adv__grid">
      {
        site.advantages.map((a, i) => (
          <article class="adv__item">
            <span class="adv__num tabnum" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
            <h3>{a.title}</h3>
            <p>{a.text}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .adv { border-block: 1px solid var(--line); background: var(--surface); }
  .adv__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 40px 36px;
  }
  .adv__item { display: flex; flex-direction: column; gap: 8px; }
  .adv__num {
    font-family: var(--font-display);
    font-size: 0.78rem;
    letter-spacing: var(--label-tracking);
    color: var(--accent);
  }
  .adv__item p { color: var(--fg-soft); font-size: 0.96rem; }
</style>
